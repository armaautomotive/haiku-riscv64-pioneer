SubDir HAIKU_TOP src apps assistant ;

UsePrivateHeaders shared ;
Application HaikuAssistant : Assistant.cpp ToolBridge.cpp ToolSession.cpp
	: be shared [ TargetLibstdc++ ] [ TargetLibsupc++ ]
	: Assistant.rdef
	;

Application HaikuAssistantControl : ServiceControl.cpp
	: be [ TargetLibstdc++ ] [ TargetLibsupc++ ]
	;

SubDirHdrs [ FDirName $(HAIKU_TOP) headers os add-ons input_server ] ;
Addon HaikuAssistantShortcut : ShortcutFilter.cpp
	: be input_server [ TargetLibstdc++ ] [ TargetLibsupc++ ]
	;

