resource app_signature "application/x-vnd.Haiku-Assistant";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
	major = 0,
	middle = 1,
	minor = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Haiku Assistant prototype",
	long_info = "Native local Qwen chat powered by llama.cpp."
};
