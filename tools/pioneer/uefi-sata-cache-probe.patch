+
+STATIC
+VOID
+PioneerAhciCache (VOID *Buffer, UINTN Length, BOOLEAN Publish)
+{
+  UINTN Satp;
+  UINTN Address;
+  UINTN Last;
+
+  __asm__ __volatile__ ("csrr %0, satp" : "=r" (Satp));
+  if (Satp != 0 || Buffer == NULL || Length == 0 ||
+      Length - 1 > MAX_UINTN - (UINTN)Buffer) {
+    DEBUG ((DEBUG_ERROR, "PIONEER SATA PROBE: invalid cache address/mode; stopped\n"));
+    CpuDeadLoop ();
+  }
+  Address = (UINTN)Buffer & ~(UINTN)63;
+  Last = ((UINTN)Buffer + Length - 1) & ~(UINTN)63;
+  MemoryFence ();
+  for (;;) {
+    if (Publish) {
+      // T-Head physical clean + invalidate: th.dcache.cipa a0.
+      __asm__ __volatile__ ("mv a0, %0\n.word 0x02b5000b" :: "r" (Address) : "a0", "memory");
+    } else {
+      // T-Head physical invalidate: th.dcache.ipa a0.
+      __asm__ __volatile__ ("mv a0, %0\n.word 0x02a5000b" :: "r" (Address) : "a0", "memory");
+    }
+    if (Address == Last) {
+      break;
+    }
+    Address += 64;
+  }
+  __asm__ __volatile__ (".word 0x0190000b\nfence iorw, iorw" ::: "memory");
+}
+
+#endif
