 #include "NvmExpress.h"
 
+// Pioneer-only diagnostic, not a general DMA implementation. Physical cache
+// operations require the pinned platform's bare-address firmware mode.
+STATIC VOID
+PioneerProbeCache (VOID *Buffer, UINTN Size, BOOLEAN Flush)
+{
+  UINTN Address;
+  UINTN End;
+  UINTN Satp;
+  __asm__ __volatile__ ("csrr %0, satp" : "=r" (Satp));
+  if (Satp != 0 || Size == 0 || (Size - 1) > MAX_ADDRESS - (UINTN)Buffer) {
+    DEBUG ((DEBUG_ERROR, "PIONEER DMA PROBE: invalid cache range or non-bare SATP\n"));
+    CpuDeadLoop ();
+  }
+  End = (UINTN)Buffer + Size - 1;
+  Address = (UINTN)Buffer & ~(UINTN)63;
+  for (;;) {
+    // Encodings from Linux arch/riscv/errata/thead/errata.c: physical-address
+    // th.dcache.cipa / th.dcache.ipa, followed by th.sync.s.
+    if (Flush) {
+      __asm__ __volatile__ ("mv a0, %0\n.long 0x02b5000b" : : "r" (Address) : "a0", "memory");
+    } else {
+      __asm__ __volatile__ ("mv a0, %0\n.long 0x02a5000b" : : "r" (Address) : "a0", "memory");
+    }
+    if (End - Address < 64) {
+      break;
+    }
+    Address += 64;
+  }
+  __asm__ __volatile__ (".long 0x0190000b\nfence iorw, iorw" : : : "memory");
+}
