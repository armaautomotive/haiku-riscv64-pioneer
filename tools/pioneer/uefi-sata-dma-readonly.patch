+/** @file
+  Opt-in SG2042 non-coherent DMA support for the Pioneer firmware experiment.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef PIONEER_SATA_DMA_H_
+#define PIONEER_SATA_DMA_H_
+
+EFI_STATUS
+PioneerSataDmaMap (
+  IN EFI_PCI_IO_PROTOCOL *PciIo,
+  IN EFI_PCI_IO_PROTOCOL_OPERATION Operation,
+  IN VOID *HostAddress,
+  IN OUT UINTN *NumberOfBytes,
+  OUT EFI_PHYSICAL_ADDRESS *DeviceAddress,
+  OUT VOID **Mapping
+  );
+
+EFI_STATUS
+PioneerSataDmaUnmap (IN EFI_PCI_IO_PROTOCOL *PciIo, IN VOID *Mapping);
+
+// Clean/invalidate CPU-owned storage before handing it to the controller.
+VOID
+PioneerSataDmaPublish (IN VOID *Buffer, IN UINTN Length);
+
+// Invalidate device-owned, CPU-read-only storage before observing completion.
+VOID
+PioneerSataDmaObserve (IN VOID *Buffer, IN UINTN Length);
+
+#endif
