diff --git a/MdeModulePkg/Bus/Pci/NvmExpressDxe/NvmExpressDma.c b/MdeModulePkg/Bus/Pci/NvmExpressDxe/NvmExpressDma.c
new file mode 100644
index 0000000000..901c6a58d2
--- /dev/null
+++ b/MdeModulePkg/Bus/Pci/NvmExpressDxe/NvmExpressDma.c
@@ -0,0 +1,198 @@
+/** @file
+  Pioneer SG2042 DMA ownership support. This is not a generic RISC-V backend.
+
+  Streaming buffers use private page-aligned storage: invalidating a partial
+  cache line belonging to the caller could otherwise destroy unrelated data.
+  Common buffers remain shared and require explicit queue/PRP synchronization.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "NvmExpress.h"
+
+#ifdef PIONEER_NVME_NON_COHERENT_DMA
+#ifndef MDE_CPU_RISCV64
+#error Pioneer DMA requires RISC-V 64
+#endif
+
+#define PIONEER_CACHE_LINE  64U
+
+typedef struct {
+  VOID                           *InnerMapping;
+  VOID                           *Host;
+  VOID                           *Bounce;
+  UINTN                          Bytes;
+  UINTN                          Pages;
+  EFI_PCI_IO_PROTOCOL_OPERATION   Operation;
+} NVME_DMA_MAPPING;
+
+STATIC
+BOOLEAN
+NvmeDmaBareAddressing (VOID)
+{
+  UINTN Satp;
+
+  __asm__ __volatile__ ("csrr %0, satp" : "=r" (Satp));
+  return Satp == 0;
+}
+
+STATIC
+VOID
+NvmeDmaCache (VOID *Buffer, UINTN Length, BOOLEAN Publish)
+{
+  UINTN Address;
+  UINTN Last;
+
+  if (Length == 0) {
+    return;
+  }
+
+  // Physical CMO encodings require bare addressing. Do not silently apply
+  // them to virtual addresses if a future firmware enables its MMU.
+  if (!NvmeDmaBareAddressing () || Buffer == NULL ||
+      Length - 1 > MAX_UINTN - (UINTN)Buffer) {
+    DEBUG ((DEBUG_ERROR, "PIONEER DMA: invalid cache range/address mode\n"));
+    CpuDeadLoop ();
+  }
+
+  Address = (UINTN)Buffer & ~(UINTN)(PIONEER_CACHE_LINE - 1);
+  Last = ((UINTN)Buffer + Length - 1) & ~(UINTN)(PIONEER_CACHE_LINE - 1);
+  MemoryFence ();
+  for (;;) {
+    if (Publish) {
+      // th.dcache.cipa a0 (physical clean + invalidate).
+      __asm__ __volatile__ ("mv a0, %0\n.word 0x02b5000b" :: "r" (Address) : "a0", "memory");
+    } else {
+      // th.dcache.ipa a0; never write stale completion data back to RAM.
+      __asm__ __volatile__ ("mv a0, %0\n.word 0x02a5000b" :: "r" (Address) : "a0", "memory");
+    }
+    if (Address == Last) {
+      break;
+    }
+    Address += PIONEER_CACHE_LINE;
+  }
+  // Complete cache operations before a doorbell or any CPU data access.
+  __asm__ __volatile__ (".word 0x0190000b\nfence iorw, iorw" ::: "memory");
+}
+#endif
+
+VOID
+NvmeDmaPublish (VOID *Buffer, UINTN Length)
+{
+#ifdef PIONEER_NVME_NON_COHERENT_DMA
+  NvmeDmaCache (Buffer, Length, TRUE);
+#endif
+}
+
+VOID
+NvmeDmaObserve (VOID *Buffer, UINTN Length)
+{
+#ifdef PIONEER_NVME_NON_COHERENT_DMA
+  NvmeDmaCache (Buffer, Length, FALSE);
+#endif
+}
+
+EFI_STATUS
+NvmeDmaMap (
+  EFI_PCI_IO_PROTOCOL *PciIo,
+  EFI_PCI_IO_PROTOCOL_OPERATION Operation,
+  VOID *HostAddress,
+  UINTN *NumberOfBytes,
+  EFI_PHYSICAL_ADDRESS *DeviceAddress,
+  VOID **Mapping
+  )
+{
+#ifndef PIONEER_NVME_NON_COHERENT_DMA
+  return PciIo->Map (PciIo, Operation, HostAddress, NumberOfBytes, DeviceAddress, Mapping);
+#else
+  NVME_DMA_MAPPING *Map;
+  EFI_STATUS Status;
+  UINTN Length;
+
+  if (PciIo == NULL || HostAddress == NULL || NumberOfBytes == NULL ||
+      DeviceAddress == NULL || Mapping == NULL || *NumberOfBytes == 0 ||
+      *NumberOfBytes > MAX_UINTN - EFI_PAGE_MASK) {
+    return EFI_INVALID_PARAMETER;
+  }
+  *Mapping = NULL;
+  if (!NvmeDmaBareAddressing ()) {
+    return EFI_UNSUPPORTED;
+  }
+  // These are the only operations the NVMe driver uses. Refuse additions
+  // until their ownership semantics have been implemented and tested.
+  if (Operation != EfiPciIoOperationBusMasterRead &&
+      Operation != EfiPciIoOperationBusMasterWrite &&
+      Operation != EfiPciIoOperationBusMasterCommonBuffer) {
+    return EFI_UNSUPPORTED;
+  }
+  Map = AllocateZeroPool (sizeof (*Map));
+  if (Map == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Map->Host = HostAddress;
+  Map->Bytes = *NumberOfBytes;
+  Map->Operation = Operation;
+  Length = Map->Bytes;
+  if (Operation == EfiPciIoOperationBusMasterCommonBuffer) {
+    Status = PciIo->Map (PciIo, Operation, HostAddress, &Length,
+                        DeviceAddress, &Map->InnerMapping);
+  } else {
+    Map->Pages = EFI_SIZE_TO_PAGES (Map->Bytes);
+    Status = PciIo->AllocateBuffer (PciIo, AllocateAnyPages,
+                 EfiBootServicesData, Map->Pages, &Map->Bounce, 0);
+    if (EFI_ERROR (Status)) {
+      FreePool (Map);
+      return Status;
+    }
+    ZeroMem (Map->Bounce, EFI_PAGES_TO_SIZE (Map->Pages));
+    if (Operation == EfiPciIoOperationBusMasterRead) {
+      CopyMem (Map->Bounce, HostAddress, Map->Bytes);
+    }
+    NvmeDmaPublish (Map->Bounce, EFI_PAGES_TO_SIZE (Map->Pages));
+    // Map private storage as common so the PCI layer cannot introduce a
+    // second, unmaintained streaming bounce buffer underneath this one.
+    Status = PciIo->Map (PciIo, EfiPciIoOperationBusMasterCommonBuffer,
+                        Map->Bounce, &Length, DeviceAddress, &Map->InnerMapping);
+  }
+  if (EFI_ERROR (Status) || Length != Map->Bytes) {
+    if (!EFI_ERROR (Status)) {
+      PciIo->Unmap (PciIo, Map->InnerMapping);
+      Status = EFI_BAD_BUFFER_SIZE;
+    }
+    if (Map->Bounce != NULL) {
+      PciIo->FreeBuffer (PciIo, Map->Pages, Map->Bounce);
+    }
+    FreePool (Map);
+    return Status;
+  }
+  *Mapping = Map;
+  return EFI_SUCCESS;
+#endif
+}
+
+EFI_STATUS
+NvmeDmaUnmap (EFI_PCI_IO_PROTOCOL *PciIo, VOID *Mapping)
+{
+#ifndef PIONEER_NVME_NON_COHERENT_DMA
+  return PciIo->Unmap (PciIo, Mapping);
+#else
+  NVME_DMA_MAPPING *Map;
+  EFI_STATUS Status;
+
+  if (Mapping == NULL) {
+    return EFI_SUCCESS;
+  }
+  Map = Mapping;
+  // The caller must have observed completion or stopped the controller.
+  if (Map->Operation == EfiPciIoOperationBusMasterWrite) {
+    NvmeDmaObserve (Map->Bounce, EFI_PAGES_TO_SIZE (Map->Pages));
+    CopyMem (Map->Host, Map->Bounce, Map->Bytes);
+  }
+  Status = PciIo->Unmap (PciIo, Map->InnerMapping);
+  if (Map->Bounce != NULL) {
+    PciIo->FreeBuffer (PciIo, Map->Pages, Map->Bounce);
+  }
+  FreePool (Map);
+  return Status;
+#endif
+}
