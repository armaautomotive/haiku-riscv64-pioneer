--- /dev/null
+++ b/MdeModulePkg/Bus/Pci/NvmExpressDxe/NvmExpressDma.h
@@ -0,0 +1,30 @@
+/** @file
+  Opt-in SG2042 non-coherent DMA support for the Pioneer firmware experiment.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef NVME_DMA_H_
+#define NVME_DMA_H_
+
+EFI_STATUS
+NvmeDmaMap (
+  IN EFI_PCI_IO_PROTOCOL *PciIo,
+  IN EFI_PCI_IO_PROTOCOL_OPERATION Operation,
+  IN VOID *HostAddress,
+  IN OUT UINTN *NumberOfBytes,
+  OUT EFI_PHYSICAL_ADDRESS *DeviceAddress,
+  OUT VOID **Mapping
+  );
+
+EFI_STATUS
+NvmeDmaUnmap (IN EFI_PCI_IO_PROTOCOL *PciIo, IN VOID *Mapping);
+
+// Clean/invalidate CPU-owned storage before handing it to the controller.
+VOID
+NvmeDmaPublish (IN VOID *Buffer, IN UINTN Length);
+
+// Invalidate device-owned, CPU-read-only storage before observing completion.
+VOID
+NvmeDmaObserve (IN VOID *Buffer, IN UINTN Length);
+
+#endif
