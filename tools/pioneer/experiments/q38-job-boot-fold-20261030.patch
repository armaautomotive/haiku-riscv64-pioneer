+/* SPDX-License-Identifier: MIT */
+// Disposable DATA-grammar equivalence experiment. No device/model/Work grant.
+#include "../PioneerQ38PushedWorkerLayout.h"
+#include <array>
+#include <cassert>
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+namespace P=PioneerQ38PushedWorkerLayout;
+using Words=std::array<uint32_t,64>;
+// Frozen original implementation from 5e1a07f6e77fb9be42a522e30166959da253929c.
+static bool OriginalBoot(const uint32_t* b){
+ if(!b || b[0]!=P::Magic)return false;
+ for(unsigned i=40;i<=54;i++)if(b[i]!=P::BootWord(i))return false;
+ uint32_t old[64];P::OldBoot(b,old);return P::Base::BootShape(old);
+}
+static __attribute__((noinline)) bool Original(const uint32_t* j,const uint32_t* b,unsigned previous,unsigned densePhase){
+ if(!j || j[0]!=P::Magic || !OriginalBoot(b))return false;
+ uint32_t oldBoot[64],oldJob[64];P::OldBoot(b,oldBoot);
+ for(unsigned i=0;i<64;i++)oldJob[i]=i?j[i]:unsigned(P::Base::Magic);
+ if(j[2]==P::GlobalMatrix){if(j[31]!=P::JobWitness)return false;oldJob[31]=P::Base::JobWitness;}
+ return P::Base::JobShape(oldJob,oldBoot,previous,densePhase);
+}
+static uint64_t cases=0,accepted=0,refused=0;
+static void Check(const uint32_t* j,const uint32_t* b,unsigned previous,unsigned phase){
+ Words savedJob={},savedBoot={};if(j)for(unsigned i=0;i<64;i++)savedJob[i]=j[i];
+ if(b)for(unsigned i=0;i<64;i++)savedBoot[i]=b[i];
+ const bool a=Original(j,b,previous,phase),z=P::JobShape(j,b,previous,phase);
+ if(a!=z){std::fprintf(stderr,"MISMATCH case%llu previous%u phase%u old%u candidate%u\n",
+  static_cast<unsigned long long>(cases),previous,phase,unsigned(a),unsigned(z));assert(false);}
+ if(j)for(unsigned i=0;i<64;i++)assert(j[i]==savedJob[i]);
+ if(b)for(unsigned i=0;i<64;i++)assert(b[i]==savedBoot[i]);
+ cases++;accepted+=a;refused+=!a;
+}
+static uint32_t seed=0x51574733;
+static uint32_t Random(){seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return seed;}
+static Words Boot(unsigned worker){
+ Words b={};b[0]=P::Magic;b[1]=1;b[2]=64;b[3]=worker;b[4]=P::Peer(worker);
+ b[5]=b[16]=0x12345678;b[6]=8192;b[7]=64;
+ for(unsigned i=8;i<16;i+=2)b[i]=i;
+ for(unsigned i=17;i<32;i++)b[i]=0x5a5a0000+i;
+ for(unsigned i=40;i<=54;i++)b[i]=P::BootWord(i);
+ assert(P::BootShape(b.data()));return b;
+}
+struct Job {Words words;unsigned phase;};
+static std::vector<Job> Jobs(const Words& b){
+ std::vector<Job> jobs;
+ for(unsigned op=1;op<=12;op++){
+  Words j={};j[0]=P::Magic;j[1]=8;j[2]=op;j[3]=b[3];j[4]=b[4];j[5]=op>=9?3:0;
+  j[6]=8191;j[7]=2025;for(unsigned i=8;i<16;i++)j[i]=b[i];
+  unsigned phase=op>=9 && op<=11?op-9:0;
+  if(op==3){j[16]=P::ActivationMagic;j[17]=256;j[18]=576;j[19]=j[7];j[20]=12;j[27]=248319;}
+  if(op==12){
+   j[5]=64;j[16]=0x31483851;j[17]=14;j[18]=3392;j[21]=5120;j[22]=0x04000000;
+   j[23]=1;j[24]=PioneerQ38ProjectionRoute(0);j[25]=j[26]=1;j[27]=0;j[28]=0;
+   j[29]=248320;j[30]=1;j[31]=P::JobWitness;
+  }
+  if(Original(j.data(),b.data(),7,phase))jobs.push_back({j,phase});
+ }
+ Words stop={};stop[0]=P::Magic;stop[1]=8;stop[2]=P::Stop;stop[3]=b[3];stop[4]=b[4];
+ stop[5]=64;stop[6]=8191;stop[7]=2025;for(unsigned i=8;i<16;i++)stop[i]=b[i];
+ assert(Original(stop.data(),b.data(),7,0));jobs.push_back({stop,0});return jobs;
+}
+#ifndef PIONEER_Q38_JOB_BOOT_FOLD_DATA_ONLY
+int main(){
+ unsigned validSeeds=0;
+ for(unsigned worker:{1U,21U,68U,69U,96U,97U,119U}){
+  const auto boot=Boot(worker);auto jobs=Jobs(boot);
+  for(const auto& job:jobs){
+   const auto& j=job.words;assert(Original(j.data(),boot.data(),7,job.phase));validSeeds++;
+   Check(j.data(),boot.data(),7,job.phase);
+   Check(nullptr,boot.data(),7,job.phase);Check(j.data(),nullptr,7,job.phase);
+   for(unsigned previous:{0U,6U,7U,8U,0x7ffffffdU,0x7ffffffeU,0x7fffffffU,0xffffffffU})
+    for(unsigned phase:{0U,1U,2U,3U,11U,0xffffffffU})Check(j.data(),boot.data(),previous,phase);
+   for(unsigned i=0;i<64;i++)for(unsigned bit=0;bit<32;bit++){
+    auto b=boot;auto changed=j;b[i]^=uint32_t(1)<<bit;
+    Check(j.data(),b.data(),7,job.phase);changed[i]^=uint32_t(1)<<bit;
+    Check(changed.data(),boot.data(),7,job.phase);
+   }
+   for(unsigned trial=0;trial<4096;trial++){
+    auto b=boot;auto changed=j;
+    for(unsigned n=0;n<1+(trial&7);n++){
+     const auto index=Random()%64,mask=Random();if(Random()&1)b[index]^=mask;else changed[index]^=mask;
+    }
+    Check(changed.data(),b.data(),7,job.phase);
+   }
+  }
+ }
+ Check(nullptr,nullptr,0,0);
+ assert(validSeeds>=65 && accepted>validSeeds && refused>200000);
+ std::printf("PASS frozen original/candidate DATA JobShape: %u valid seeds, %llu cases, %llu accepts, %llu refusals; every boot/job bit + paired mutations + null/phase/nonce boundaries; inputs unchanged; NOT emitted firmware/model/native/physical/Work/TPS\n",
+  validSeeds,static_cast<unsigned long long>(cases),static_cast<unsigned long long>(accepted),static_cast<unsigned long long>(refused));
+}
+#endif
