+/* SPDX-License-Identifier: MIT */
+// Isolated actual controller instructions over immutable synthetic DATA.
+// This does not acquire a device, native owner, layer, token or Work result.
+#define PIONEER_TENSIX_MACHINE_ONLY
+#include "pioneer_tensix_image_test.cpp"
+#define PIONEER_Q38_JOB_BOOT_FOLD_DATA_ONLY
+#include "pioneer_q38_job_boot_fold_test.cpp"
+#include <map>
+#include <memory>
+#include <string>
+struct JobImage {
+ std::vector<uint8_t> text,conv,terminal;unsigned entry;
+ JobImage(const char* directory,const char* address):
+  text(Read((std::string(directory)+"/text.bin").c_str())),
+  conv(Read((std::string(directory)+"/conv.bin").c_str())),
+  terminal(Read((std::string(directory)+"/terminal.bin").c_str())){
+  entry=unsigned(std::stoul(address,nullptr,16));assert(entry>=0x40000 && entry<0x40000+text.size());
+ }
+ bool Contains(unsigned a)const{return (a>=0x40000 && a-0x40000<text.size())
+  || (a>=0x64000 && a-0x64000<conv.size()) || (a>=0x60000 && a<0x60008);}
+ unsigned At(unsigned a)const{
+  assert(!(a&3) && Contains(a));return a>=0x64000?Word(conv,a-0x64000):
+   a>=0x60000?Word(terminal,a-0x60000):Word(text,a-0x40000);
+ }
+};
+struct JobMachine:Machine {
+ enum {JobPointer=0x72000,BootPointer=0x72100,Return=0x60004,StackTop=0x70000,StackLow=0x6d000};
+ const JobImage& image;Words job={},boot={};bool hasJob,hasBoot;
+ std::map<unsigned,unsigned> stack;unsigned inputReads=0,writes=0,minStack=StackTop;
+ JobMachine(const JobImage& rom,const uint32_t* j,const uint32_t* b,unsigned previous,unsigned phase):
+  image(rom),hasJob(j),hasBoot(b){
+  if(j)for(unsigned i=0;i<64;i++)job[i]=j[i];if(b)for(unsigned i=0;i<64;i++)boot[i]=b[i];
+  regs[1]=Return;regs[2]=StackTop;regs[10]=j?JobPointer:0;regs[11]=b?BootPointer:0;regs[12]=previous;regs[13]=phase;
+  for(unsigned r:{8U,9U,18U,19U,20U,21U,22U,23U,24U,25U,26U,27U})regs[r]=0x90000000U+r;
+  pc=image.entry;
+ }
+ bool CodeAddress(unsigned a)const override{return image.Contains(a);}
+ unsigned Index(unsigned a)override{l1[8180]=image.At(a);return 8180;}
+ unsigned StepLimit()const override{return 100000;}
+ uint32_t Load(unsigned a)override{
+  assert(!(a&3));if(image.Contains(a))return image.At(a);
+  if(a>=JobPointer && a<JobPointer+256){assert(hasJob);inputReads++;return job[(a-JobPointer)/4];}
+  if(a>=BootPointer && a<BootPointer+256){assert(hasBoot);inputReads++;return boot[(a-BootPointer)/4];}
+  assert(a>=StackLow && a<StackTop && stack.count(a));return stack.at(a);
+ }
+ void Store(unsigned a,unsigned value)override{
+  assert(!(a&3) && a>=StackLow && a<StackTop);stack[a]=value;writes++;if(a<minStack)minStack=a;
+ }
+ bool RunCall(){
+  while(pc!=Return)Step();
+  assert(regs[10]<=1 && regs[1]==Return && regs[2]==StackTop);
+  for(unsigned r:{8U,9U,18U,19U,20U,21U,22U,23U,24U,25U,26U,27U})assert(regs[r]==0x90000000U+r);
+  const bool result=regs[10];const auto oldWrites=writes,oldReads=inputReads;
+  for(unsigned i=0;i<2048;i++)Step();assert(pc==Return && writes==oldWrites && inputReads==oldReads);return result;
+ }
+};
+static unsigned emittedCases=0,emittedRefusals=0;
+static void Compare(const JobImage& old,const JobImage& candidate,const uint32_t* j,const uint32_t* b,
+ unsigned previous,unsigned phase,bool report=false){
+ Check(j,b,previous,phase);const bool expected=Original(j,b,previous,phase);
+ auto a=std::make_unique<JobMachine>(old,j,b,previous,phase),z=std::make_unique<JobMachine>(candidate,j,b,previous,phase);
+ const bool x=a->RunCall(),y=z->RunCall();
+ if(x!=expected || y!=expected){std::fprintf(stderr,"EMITTED MISMATCH case%u expected%u old%u candidate%u\n",emittedCases,unsigned(expected),unsigned(x),unsigned(y));assert(false);}
+ if(report){assert(expected && z->steps<a->steps && z->inputReads<a->inputReads);
+  std::printf("PASS actual ordinary descriptor instructions%u->%u private-input reads%u->%u observed stack bytes%u->%u;not cycles/TPS\n",
+   a->steps-2048,z->steps-2048,a->inputReads,z->inputReads,JobMachine::StackTop-a->minStack,JobMachine::StackTop-z->minStack);}
+ emittedCases++;emittedRefusals+=!expected;
+}
+int main(int argc,char** argv){
+ assert(argc==5);setvbuf(stdout,nullptr,_IOLBF,0);JobImage old(argv[1],argv[3]),candidate(argv[2],argv[4]);
+ unsigned validSeeds=0;
+ for(unsigned worker:{1U,21U,68U,69U,96U,97U,119U}){
+  auto b=Boot(worker);for(const auto& job:Jobs(b)){
+   validSeeds++;const auto& j=job.words;Compare(old,candidate,j.data(),b.data(),7,job.phase,validSeeds==1);
+   Compare(old,candidate,nullptr,b.data(),7,job.phase);Compare(old,candidate,j.data(),nullptr,7,job.phase);
+   for(unsigned previous:{0U,7U,0x7ffffffeU,0xffffffffU})
+    for(unsigned phase:{0U,1U,2U,3U})Compare(old,candidate,j.data(),b.data(),previous,phase);
+  }
+ }
+ auto b=Boot(1);auto j=Jobs(b).front().words;
+ for(unsigned i=0;i<64;i++)for(unsigned bit=0;bit<32;bit++){
+  auto alteredBoot=b,alteredJob=j;alteredBoot[i]^=uint32_t(1)<<bit;alteredJob[i]^=uint32_t(1)<<bit;
+  Compare(old,candidate,j.data(),alteredBoot.data(),7,0);Compare(old,candidate,alteredJob.data(),b.data(),7,0);
+ }
+ for(unsigned trial=0;trial<512;trial++){
+  auto alteredBoot=b,alteredJob=j;
+  for(unsigned n=0;n<1+(trial&7);n++){auto index=Random()%64,mask=Random();if(Random()&1)alteredBoot[index]^=mask;else alteredJob[index]^=mask;}
+  Compare(old,candidate,alteredJob.data(),alteredBoot.data(),7,0);
+ }
+ Compare(old,candidate,nullptr,nullptr,0,0);
+ assert(validSeeds==81 && emittedCases==6148 && emittedRefusals>5000);
+ std::printf("PASS actual old/candidate JobShape %u cases/%u refusals/%u valid seeds;all boot+job bits,paired mutations,null/phase/nonce bounds;host frozen result exact,immutable arguments,stack-only stores,no MMIO,callee-saved registers+SP restored,inert2048;NOT connected/model/native/physical/Work/TPS\n",emittedCases,emittedRefusals,validSeeds);
+}
