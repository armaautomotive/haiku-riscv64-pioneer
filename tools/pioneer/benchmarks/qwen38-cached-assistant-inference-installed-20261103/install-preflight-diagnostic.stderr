   99 /boot/system/servers/registrar                     
  100 /boot/system/servers/debug_server                  
  102 /boot/system/servers/mount_server                  
  103 /bin/sshd -f /dev/null -h /boot/home/config/settings/ssh/ssh_ho 
  104 /boot/system/servers/net_server                    
  106 /boot/system/servers/package_daemon                
  111 /boot/system/servers/launch_daemon baron           
  113 /boot/system/servers/power_daemon                  
  117 /boot/system/servers/syslog_daemon                 
  131 /boot/system/servers/media_server                  
  175 /boot/system/servers/app_server                    
  187 /boot/system/Tracker                               
  189 /boot/system/Deskbar                               
  208 /boot/system/servers/input_server                  
  232 /boot/system/servers/media_addon_server            
  296 /boot/system/servers/notification_server           
  577 /boot/system/bin/screen_blanker                    
  964 /packages/openssh-9.8p1-2/.self/lib/openssh/sshd-session -f /de 
  966 /packages/openssh-9.8p1-2/.self/lib/openssh/sshd-session -f /de 
  967 /bin/bash -c stage=/boot/home/pioneer-assistant-cache-installed 
  971 /boot/system/bin/sh -x -s -- --apply               
 1012 /boot/system/bin/ps -o Id -o Team                  '
+ awk -v self=971 '
 $1=="Id" && $2=="Team" && NF==2 {header++;next}
 $1 ~ /^[0-9]+$/ && NF>=2 {
  teams++;if($1==self)next
  if($0 ~ /(^|[\/[:space:]])(Assistant|HaikuAssistant|llama-|tenstorrent_haiku|inference-|pioneer_q38|pioneer-q|pioneer-native-bfp|pioneer-dram|pioneer-assistant-cache|graph-csr-debug|source-check)/)owners++
  next
 }
 NF{bad++} END{if(header!=1 || !teams || bad || owners)exit 1}'
+ exit 1
